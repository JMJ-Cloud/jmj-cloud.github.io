---
// BaseLayout.astro
// HTML shell with meta, fonts, Header, Footer
import Header from '../components/Header.astro';
import MobileNav from '../components/MobileNav.astro';
import Footer from '../components/Footer.astro';
import GridBackground from '../components/GridBackground.astro';
import Clarity from '../components/Clarity.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import CookieConsent from '../components/CookieConsent.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
}

const {
  title,
  description = 'JMJ Cloud - Oracle Technology Delivered. We build and extend Oracle solutions (ERP Cloud, APEX, E-Business Suite) with modern architecture and clean code.',
  currentPath = Astro.url.pathname,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/images/og-default.png', Astro.site).href;

const siteTitle = title === 'Home' ? 'JMJ Cloud | Oracle Technology Delivered' : `${title} | JMJ Cloud`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{siteTitle}</title>
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title="JMJ Cloud" href="/rss.xml" />

    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Google Fonts -->
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JMJ Cloud" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Theme Color -->
    <meta name="theme-color" content="#0a0a0f" />

    <!-- Analytics (only in production) -->
    {import.meta.env.PROD && <Clarity />}
    {import.meta.env.PROD && <GoogleAnalytics />}
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <GridBackground />
    <Header currentPath={currentPath} />
    <MobileNav currentPath={currentPath} />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <!-- Cookie Consent (only in production) -->
    {import.meta.env.PROD && <CookieConsent />}
  </body>
</html>

<style is:global>
  html {
    scrollbar-gutter: stable;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  body.nav-open {
    overflow: hidden;
  }

  main {
    flex: 1;
    padding-top: var(--header-height);
  }
</style>
