---
// SolutionPost.astro
// Solution / accelerator detail page layout
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  tagline: string;
  category: string;
  technologies: string[];
  benefits: string[];
  summary: string;
}

const { title, tagline, category, technologies, benefits, summary } = Astro.props;
---

<BaseLayout title={title} description={summary} currentPath="/products">
  <article class="solution-post">
    <div class="container">
      <header class="post-header">
        <a href="/products" class="back-link">
          <span aria-hidden="true">←</span> Back to Products
        </a>

        <h1 class="post-title">{title}</h1>
        <p class="post-tagline">{tagline}</p>

        <div class="post-meta">
          <div class="meta-tags">
            <span class="tag industry">{category}</span>
            {technologies.map((tech) => (
              <span class="tag tech">{tech}</span>
            ))}
          </div>
        </div>

        {benefits.length > 0 && (
          <div class="post-benefits">
            {benefits.map((benefit) => (
              <span class="benefit">✓ {benefit}</span>
            ))}
          </div>
        )}
      </header>

      <div class="post-content prose">
        <slot />
      </div>

      <section class="solution-cta glow-border">
        <h2>We implement this in your tenancy</h2>
        <p>
          This is a proven pattern from real engagements. We set it up in your
          environment, document it, and hand it over to your team.
        </p>
        <a href="/contact" class="btn btn-primary">Talk to Us</a>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .solution-post {
    padding: var(--space-12) 0 var(--space-20);
  }

  .post-header {
    max-width: 700px;
    margin: 0 auto var(--space-12);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-decoration: none;
    margin-bottom: var(--space-6);
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--accent-primary);
  }

  .post-title {
    font-size: var(--text-3xl);
    line-height: 1.2;
    margin-bottom: var(--space-3);
  }

  .post-tagline {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .post-meta {
    margin-bottom: var(--space-4);
  }

  .meta-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
  }

  .tag.tech {
    color: var(--accent-primary);
    background-color: var(--accent-glow);
  }

  .tag.industry {
    color: var(--warning);
    background-color: rgba(255, 170, 0, 0.15);
  }

  .post-benefits {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    background-color: var(--bg-secondary);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }

  .benefit {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--success);
  }

  .post-content {
    max-width: 700px;
    margin: 0 auto;
  }

  .prose {
    font-size: var(--text-base);
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .prose :global(h2) {
    font-size: var(--text-2xl);
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
    color: var(--text-primary);
  }

  .prose :global(h3) {
    font-size: var(--text-xl);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    color: var(--text-primary);
  }

  .prose :global(p) {
    margin-bottom: var(--space-4);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: var(--space-4);
    padding-left: var(--space-6);
  }

  .prose :global(li) {
    margin-bottom: var(--space-2);
  }

  .prose :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .solution-cta {
    max-width: 700px;
    margin: var(--space-16) auto 0;
    padding: var(--space-8);
    background-color: var(--bg-secondary);
    border-radius: var(--radius-lg);
    text-align: center;
  }

  .solution-cta h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-3);
  }

  .solution-cta p {
    color: var(--text-secondary);
    margin-bottom: var(--space-6);
  }
</style>
