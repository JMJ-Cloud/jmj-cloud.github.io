---
// blog/index.astro
// Blog listing page
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';
import BlogSearch from '../../components/BlogSearch.astro';
import { getCollection } from 'astro:content';
import { isArchived } from '../../lib/blog';

// Get all non-draft blog posts sorted by date
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const currentPosts = sortedPosts.filter((post) => !isArchived(post));
const archivedPosts = sortedPosts.filter((post) => isArchived(post));
---

<BaseLayout
  title="Blog"
  description="Technical insights on Oracle APEX, ORDS, EBS, and Cloud ERP from JMJ Cloud."
  currentPath="/blog"
>
  <section class="blog-listing">
    <div class="container">
      <header class="blog-header">
        <h1 class="blog-title">Blog</h1>
        <p class="blog-description">
          Technical insights on Oracle APEX, ORDS, EBS, and Cloud ERP
        </p>
      </header>

      <BlogSearch />

      <div id="posts-grid">
        <div class="posts-grid">
          {currentPosts.map((post) => (
            <BlogPostCard
              title={post.data.title}
              date={post.data.date}
              summary={post.data.summary}
              slug={post.slug}
              tags={post.data.tags}
            />
          ))}
        </div>

        {archivedPosts.length > 0 && (
          <details class="blog-archive">
            <summary class="archive-summary">
              Archive: {archivedPosts.length} posts from 2016 to 2021
            </summary>
            <p class="archive-note">
              Earlier writing on APEX, ORDS, and Oracle ERP. The ideas hold up, but
              product versions and screens have moved on since these were written.
            </p>
            <div class="posts-grid">
              {archivedPosts.map((post) => (
            <BlogPostCard
              title={post.data.title}
              date={post.data.date}
              summary={post.data.summary}
              slug={post.slug}
              tags={post.data.tags}
            />
              ))}
            </div>
          </details>
        )}
      </div>

      {sortedPosts.length === 0 && (
        <p class="no-posts">No posts yet. Check back soon!</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .blog-listing {
    padding: var(--space-12) 0 var(--space-20);
  }

  .blog-header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .blog-title {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-4);
  }

  .blog-description {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }

  .posts-grid {
    display: grid;
    gap: var(--space-6);
  }

  .blog-archive {
    margin-top: var(--space-16);
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-8);
  }

  .archive-summary {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--text-primary);
    cursor: pointer;
  }

  .archive-summary:hover {
    color: var(--accent-primary);
  }

  .archive-note {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin: var(--space-4) 0 var(--space-8);
    max-width: 640px;
  }

  .no-posts {
    text-align: center;
    color: var(--text-muted);
    font-size: var(--text-lg);
  }

  @media (min-width: 768px) {
    .blog-listing {
      padding: var(--space-16) 0 var(--space-24);
    }

    .posts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .posts-grid {
      grid-template-columns: repeat(2, 1fr);
      max-width: 900px;
      margin: 0 auto;
    }
  }
</style>
