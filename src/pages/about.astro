---
// about.astro
// About us page
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About"
  description="Learn about JMJ Cloud, our mission, and the team behind Oracle technology solutions."
  currentPath="/about"
>
  <section class="about-hero">
    <div class="container">
      <h1 class="page-title fade-in fade-in-1">About JMJ Cloud</h1>
      <p class="page-subtitle fade-in fade-in-2">
        Senior Oracle engineers, AI coding agents, and a delivery model built for speed
      </p>
    </div>
  </section>

  <section class="mission-section">
    <div class="container">
      <div class="mission-content">
        <h2 class="section-title fade-in fade-in-3">Our Mission</h2>
        <p class="mission-text fade-in fade-in-4">
          JMJ Cloud builds, extends, and integrates Oracle ERP: Fusion Cloud, E-Business Suite,
          APEX, and Oracle Integration Cloud. We have spent more than 25 years inside these
          systems, and we know where a requirement really lives, what happens at period close,
          and what the exception path looks like.
        </p>
        <p class="mission-text fade-in fade-in-5">
          Today that experience directs AI coding agents on a delivery line we call the
          <a href="/software-factory">Software Factory</a>. Senior engineers write the
          specification, agents build against it, and every deliverable is reviewed and tested
          before it ships. The work lives in a repository you own, and we bill in 30-minute
          increments with no minimum commitment.
        </p>
        <p class="mission-text fade-in fade-in-5">
          We also turn what we learn into <a href="/products">products</a>: desktop tools and
          accelerators that came out of real delivery work and are now available to clients.
        </p>
      </div>
    </div>
  </section>

  <section class="team-section">
    <div class="container">
      <h2 class="section-title fade-in fade-in-2">Our Team</h2>
      <div class="team-grid">
        <div class="team-member fade-in fade-in-3">
          <img
            src="/images/jstokes_linkedin.jpeg"
            alt="Jamie Stokes"
            class="member-photo"
          />
          <div class="member-content">
            <h3 class="member-name">Jamie Stokes</h3>
            <p class="member-title">Co-Founder, JMJ Cloud</p>
            <p class="member-bio">
              Jamie is a seasoned IT professional and accomplished leader, based in Austin, with significant experience in Oracle technology. With expertise spanning ERP systems, cloud solutions, and enterprise architecture, Jamie assists JMJ Cloud's clients with modernizing and extending functionality of their Oracle ERP products.
            </p>
            <a href="https://www.linkedin.com/in/jamiestokes/" target="_blank" rel="noopener noreferrer" class="member-link">
              View LinkedIn Profile →
            </a>
          </div>
        </div>

        <div class="team-member fade-in fade-in-4">
          <img
            src="/images/mpaine_linkedin.jpeg"
            alt="Matt Paine"
            class="member-photo"
          />
          <div class="member-content">
            <h3 class="member-name">Matt Paine</h3>
            <p class="member-title">Co-Founder, JMJ Cloud</p>
            <p class="member-bio">
              Matt is an Oracle ERP Cloud Solution Architect with deep expertise in General Ledger, Accounts Payable,
              Cloud Expenses, and Project Portfolio Management. Based in Austin, Matt brings extensive experience in Oracle Fusion
              Cloud implementations and enterprise resource planning solutions, helping clients navigate complex cloud migrations
              and optimizations.
            </p>
            <a href="https://www.linkedin.com/in/matt-paine-a12ab17/" target="_blank" rel="noopener noreferrer" class="member-link">
              View LinkedIn Profile →
            </a>
          </div>
        </div>

        <div class="team-member fade-in fade-in-5">
          <img
            src="/images/jdixon_linkedin.jpeg"
            alt="Jon Dixon"
            class="member-photo"
          />
          <div class="member-content">
            <h3 class="member-name">Jon Dixon</h3>
            <p class="member-title">Retired Co-Founder, JMJ Cloud</p>
            <p class="member-bio">
              Jon is a thought leader and accomplished innovator who co-founded JMJ Cloud and spent years building and extending
              Oracle solutions. A pioneer in Oracle APEX modernization, Jon helped enterprises bridge the gap between legacy systems
              and modern cloud architecture. His work has been featured across Oracle community publications.
            </p>
            <a href="https://www.linkedin.com/in/dixonjd/" target="_blank" rel="noopener noreferrer" class="member-link">
              View LinkedIn Profile →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="values-section">
    <div class="container">
      <h2 class="section-title fade-in fade-in-2">Our Values</h2>
      <div class="values-grid">
        <div class="value-card glow-border fade-in fade-in-3">
          <h3 class="value-title">Senior judgment</h3>
          <p class="value-description">
            Every specification, review, and final approval comes from an engineer with decades of Oracle ERP experience. Agents do the typing, not the deciding.
          </p>
        </div>
        <div class="value-card glow-border fade-in fade-in-4">
          <h3 class="value-title">Speed you can measure</h3>
          <p class="value-description">
            We bill in 30-minute increments with no minimum, so the invoice shows how fast the work really went.
          </p>
        </div>
        <div class="value-card glow-border fade-in fade-in-5">
          <h3 class="value-title">You own everything</h3>
          <p class="value-description">
            Code, specifications, tests, and documentation live in your repository, so your team can support the work long after we step back.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    padding: var(--space-20) 0 var(--space-16);
    text-align: center;
  }

  .page-title {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-4);
  }

  .page-subtitle {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }

  .mission-section {
    padding: var(--space-16) 0;
    background-color: var(--bg-secondary);
  }

  .mission-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .section-title {
    text-align: center;
    margin-bottom: var(--space-12);
    font-size: var(--text-3xl);
  }

  .mission-text {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.8;
    margin-bottom: var(--space-6);
  }

  .team-section {
    padding: var(--space-16) 0;
  }

  .team-grid {
    display: grid;
    gap: var(--space-8);
  }

  .team-member {
    background-color: var(--bg-secondary);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-6);
  }

  .member-photo {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--accent-primary);
  }

  .member-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .member-name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--text-primary);
  }

  .member-title {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--accent-primary);
  }

  .member-bio {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .member-link {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--accent-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
    align-self: flex-start;
  }

  .member-link:hover {
    color: var(--accent-secondary);
  }

  .values-section {
    padding: var(--space-16) 0;
    background-color: var(--bg-secondary);
  }

  .values-grid {
    display: grid;
    gap: var(--space-6);
  }

  .value-card {
    background-color: var(--bg-primary);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    text-align: center;
  }

  .value-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--text-primary);
    margin-bottom: var(--space-3);
  }

  .value-description {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .values-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .about-hero {
      padding: var(--space-24) 0 var(--space-20);
    }

    .mission-content {
      max-width: 900px;
    }
  }
</style>
